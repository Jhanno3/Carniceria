# Backend (Spring Boot) — leído por backend/src/main/resources/application.yml
# Conexión a Postgres de Supabase (región Canada Central, vía pooler). Nunca la clave service_role (constitution.md, Principio II).
# SUPABASE_DB_USERNAME/PASSWORD: el rol de runtime (app_backend.<project-ref>), SIN privilegios de
# DDL ni de bypass de RLS — ver research.md, "Rol de base de datos del backend".
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Usuario separado, solo para que Flyway aplique migraciones (dueño de las tablas, con DDL).
SUPABASE_DB_MIGRATIONS_USERNAME=
SUPABASE_DB_MIGRATIONS_PASSWORD=

# JWKS de Supabase Auth, para que el backend valide el JWT como resource server (research.md).
# Formato: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URI=

# Opcional — default 8080 si se omite (application.yml)
SERVER_PORT=

# Frontend (Vite) — solo variables con prefijo VITE_ llegan al navegador.
# Clave anónima (pública): es la única credencial de Supabase permitida en el cliente (constitution.md, Principio II).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base de la API propia (Spring Boot), no de Supabase directo.
VITE_API_BASE_URL=http://localhost:8080/api/v1
